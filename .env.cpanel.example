APP_NAME="Jessi's ClassiQ Store"
APP_ENV=staging
APP_KEY=base64:SQ34i9NrYh39IPmUruBctDWJSuyXRQ90UCJC7JkMHKQ=
APP_DEBUG=true
APP_URL=https://staging.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Security key for URL migrations (/cpanel-deploy?key=...)
CPANEL_SETUP_KEY=jessi-staging-2026

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# cPanel MySQL Database Credentials
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_shopmanager
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=your_strong_password_here

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key
PAYSTACK_SECRET_KEY=sk_test_placeholder_key
PAYSTACK_PAYMENT_URL=https://api.paystack.co
MERCHANT_EMAIL=admin@jessiclassiq.com

# OCR Engine
OCR_ENGINE=tesseract
TESSERACT_PATH=/usr/bin/tesseract
